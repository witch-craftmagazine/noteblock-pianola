    z-index: 25;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  #lb-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }
  #lb-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Duck skip overlay (shown when peter_and_the_wolf plays) ── */
  #duck-overlay {
    position: absolute;
    inset: 0;
    z-index: 25;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  #duck-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }
  #duck-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
