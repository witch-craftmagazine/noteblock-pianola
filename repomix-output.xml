		let p = presets.find((p) => p.program === program && p.isXGDrums);
		if (p) {
			returnReplacement(p);
			return p;
		}
		p = presets.find((p) => p.isAnyDrums && p.program === program);
		if (p) {
			returnReplacement(p);
			return p;
		}
		p = getAnyDrums(presets, true);
