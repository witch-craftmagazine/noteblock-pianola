* { margin: 0; padding: 0; box-sizing: border-box; }

  body {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #1a1a2e;
  transition: background 0.5s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
  }

  /* Goal 4b: Background webp class */
  body.bg-image {
  background: url('./background.webp') center / cover no-repeat;
  }

  #canvas-container {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  }

  canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
  max-width: 100vw;
  max-height: 100vh;
  object-fit: contain;
  }

  /* Loading overlay */
  #loading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  background: inherit;
  color: #fff;
  font-family: monospace;
  font-size: 14px;
  letter-spacing: 0.1em;
  transition: opacity 0.6s ease;
  pointer-events: none;
  z-index: 10;
  }

  #loading.hidden { opacity: 0; }

  .spinner {
  width: 32px;
  height: 32px;
  border: 2px solid rgba(255,255,255,0.15);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* Error message */
  #error {
  position: absolute;
  inset: 0;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
